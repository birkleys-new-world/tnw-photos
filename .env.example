# Paste these from Firebase console:
# Project settings -> Your apps -> SDK setup & config
# The apiKey is ONLY visible in the console UI (redacted from every API/CLI response).
NEXT_PUBLIC_FIREBASE_API_KEY=PASTE_API_KEY_HERE
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tnw-photos-XXXX.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tnw-photos-XXXX
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tnw-photos-XXXX.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=PASTE_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=PASTE_APP_ID
